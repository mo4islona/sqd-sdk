{
    "name": "@belopash/solana-stream",
    "version": "0.0.4",
    "description": "SVM block data streamer",
    "license": "GPL-3.0-or-later",
    "repository": "git@github.com:subsquid/squid.git",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./lib/index.cjs",
    "module": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "scripts": {
        "build": "tsx ../../../scripts/build-package.ts",
        "pack": "(cd lib && npm pack --pack-destination ..) && rm -f package.tgz && mv *.tgz package.tgz",
        "publish": "npm publish package.tgz"
    },
    "files": [
        "**/*.js",
        "**/*.cjs",
        "**/*.d.ts",
        "**/*.d.cts",
        "README.md",
        "LICENSE",
        "package.json"
    ],
    "dependencies": {
        "@belopash/core": "workspace:^",
        "bs58": "^6.0.0"
    },
    "devDependencies": {
        "tslib": "^2.8.1",
        "typescript": "~5.5.4"
    },
    "exports": {
        ".": {
            "import": {
                "default": "./lib/index.js",
                "types": "./lib/index.d.ts"
            },
            "require": {
                "default": "./lib/index.cjs",
                "types": "./lib/index.d.cts"
            }
        },
        "./instruction": {
            "import": {
                "default": "./lib/instruction.js",
                "types": "./lib/instruction.d.ts"
            },
            "require": {
                "default": "./lib/instruction.cjs",
                "types": "./lib/instruction.d.cts"
            }
        },
        "./objects/entities": {
            "import": {
                "default": "./lib/objects/entities.js",
                "types": "./lib/objects/entities.d.ts"
            },
            "require": {
                "default": "./lib/objects/entities.cjs",
                "types": "./lib/objects/entities.d.cts"
            }
        },
        "./objects": {
            "import": {
                "default": "./lib/objects/index.js",
                "types": "./lib/objects/index.d.ts"
            },
            "require": {
                "default": "./lib/objects/index.cjs",
                "types": "./lib/objects/index.d.cts"
            }
        },
        "./objects/relations": {
            "import": {
                "default": "./lib/objects/relations.js",
                "types": "./lib/objects/relations.d.ts"
            },
            "require": {
                "default": "./lib/objects/relations.cjs",
                "types": "./lib/objects/relations.d.cts"
            }
        },
        "./objects/types": {
            "import": {
                "default": "./lib/objects/types.js",
                "types": "./lib/objects/types.d.ts"
            },
            "require": {
                "default": "./lib/objects/types.cjs",
                "types": "./lib/objects/types.d.cts"
            }
        },
        "./query": {
            "import": {
                "default": "./lib/query.js",
                "types": "./lib/query.d.ts"
            },
            "require": {
                "default": "./lib/query.cjs",
                "types": "./lib/query.d.cts"
            }
        },
        "./schema": {
            "import": {
                "default": "./lib/schema.js",
                "types": "./lib/schema.d.ts"
            },
            "require": {
                "default": "./lib/schema.cjs",
                "types": "./lib/schema.d.cts"
            }
        },
        "./source": {
            "import": {
                "default": "./lib/source.js",
                "types": "./lib/source.d.ts"
            },
            "require": {
                "default": "./lib/source.cjs",
                "types": "./lib/source.d.cts"
            }
        },
        "./version": {
            "import": {
                "default": "./lib/version.js",
                "types": "./lib/version.d.ts"
            },
            "require": {
                "default": "./lib/version.cjs",
                "types": "./lib/version.d.cts"
            }
        }
    }
}
